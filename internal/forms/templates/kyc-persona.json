{
  "key": "kyc-persona",
  "title": "Onboarding persona (KYC)",
  "description": "Identidad, contacto, actividad económica y declaraciones de la persona.",
  "summary": "Para clientes persona natural: identidad con documento y selfie, contacto, actividad e ingresos, PEP y firma.",
  "schema": {
    "sections": [
      {
        "key": "identidad",
        "title": "Identidad",
        "description": "Usa los datos exactamente como aparecen en tu documento.",
        "fields": [
          { "key": "nombres", "type": "text", "label": "Nombres", "required": true },
          { "key": "apellidos", "type": "text", "label": "Apellidos", "required": true },
          { "key": "fecha_nacimiento", "type": "date", "label": "Fecha de nacimiento", "required": true },
          { "key": "nacionalidad", "type": "country", "label": "Nacionalidad", "required": true },
          { "key": "tipo_documento", "type": "radio", "label": "Tipo de documento", "required": true, "options": ["Cédula de identidad", "Pasaporte", "DNI"] },
          { "key": "rut", "type": "id", "idKind": "rut", "label": "RUT", "required": true,
            "showIf": { "field": "nacionalidad", "op": "eq", "value": "CL" } },
          { "key": "numero_documento", "type": "text", "label": "Número de documento", "required": true,
            "showIf": { "field": "nacionalidad", "op": "neq", "value": "CL" } },
          { "key": "documento_frente", "type": "file", "label": "Foto del documento (frente)", "required": true, "accept": ["image/*", "application/pdf"], "maxMb": 10 },
          { "key": "documento_reverso", "type": "file", "label": "Foto del documento (reverso)", "accept": ["image/*", "application/pdf"], "maxMb": 10,
            "showIf": { "field": "tipo_documento", "op": "neq", "value": "Pasaporte" } },
          { "key": "selfie", "type": "file", "label": "Selfie sosteniendo tu documento", "help": "Con buena luz y que se lean los datos.", "required": true, "accept": ["image/*"], "maxMb": 10 }
        ]
      },
      {
        "key": "contacto",
        "title": "Contacto y domicilio",
        "fields": [
          { "key": "email", "type": "email", "label": "Email", "required": true },
          { "key": "telefono", "type": "phone", "label": "Teléfono móvil", "required": true },
          { "key": "direccion", "type": "address", "label": "Domicilio", "required": true },
          { "key": "comprobante_domicilio", "type": "file", "label": "Comprobante de domicilio (máximo 3 meses)", "help": "Cuenta de servicios, estado de cuenta o similar.", "accept": ["application/pdf", "image/*"], "maxMb": 10 }
        ]
      },
      {
        "key": "actividad",
        "title": "Actividad económica",
        "fields": [
          { "key": "ocupacion", "type": "select", "label": "Situación laboral", "required": true,
            "options": ["Dependiente", "Independiente", "Empresario", "Jubilado", "Estudiante", "Otra"] },
          { "key": "empleador", "type": "text", "label": "Empleador o empresa",
            "showIf": { "field": "ocupacion", "op": "eq", "value": "Dependiente" } },
          { "key": "profesion", "type": "text", "label": "Profesión u oficio" },
          { "key": "ingresos_mensuales", "type": "select", "label": "Ingresos mensuales aproximados (USD)", "required": true,
            "options": ["Menos de 1.000", "1.000 a 3.000", "3.000 a 10.000", "Más de 10.000"] },
          { "key": "origen_fondos", "type": "multiselect", "label": "Origen de los fondos", "required": true,
            "options": ["Sueldo", "Honorarios", "Ventas o negocio propio", "Inversiones", "Herencia o donación", "Pensión", "Otro"] }
        ]
      },
      {
        "key": "declaraciones",
        "title": "Declaraciones",
        "fields": [
          { "key": "pep", "type": "yesno", "label": "¿Eres o fuiste Persona Expuesta Políticamente (PEP), o eres familiar cercano de una?", "required": true },
          { "key": "pep_detalle", "type": "textarea", "label": "Indica el cargo y el período", "required": true,
            "showIf": { "field": "pep", "op": "eq", "value": "Sí" } },
          { "key": "residencia_fiscal_extranjera", "type": "yesno", "label": "¿Tienes residencia fiscal en otro país?", "required": true },
          { "key": "pais_residencia_fiscal", "type": "country", "label": "País de residencia fiscal", "required": true,
            "showIf": { "field": "residencia_fiscal_extranjera", "op": "eq", "value": "Sí" } },
          { "key": "declaracion", "type": "checkbox", "label": "Declaro que la información entregada es verdadera y autorizo su verificación.", "required": true },
          { "key": "firma", "type": "signature", "label": "Firma", "required": true }
        ]
      }
    ]
  }
}
